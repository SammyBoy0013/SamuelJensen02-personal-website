# Copy to .env.local and fill in. Never commit real values.
# The same variables go in Vercel → Project → Settings → Environment Variables.

# Neon: pooled connection for the site, direct connection for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js with GitHub. AUTH_SECRET: any long random string (npx auth secret)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Samuel's numeric GitHub user ID: the only account allowed into /admin
ADMIN_GITHUB_ID=

# Vercel Blob (gallery and project photos)
BLOB_READ_WRITE_TOKEN=

# https://samueljensen.com once the domain is live; leave empty to use the Vercel URL
NEXT_PUBLIC_SITE_URL=

# The phone number and date of birth are not environment variables: they are
# entered in admin → Settings and stored only in the database.
